{
  "rewrites": [
    {
      "source": "/api/auth-code",
      "destination": "/api/index?service=auth-code"
    },
    {
      "source": "/api/discovery",
      "destination": "/api/index?service=discovery"
    },
    {
      "source": "/api/entitlement",
      "destination": "/api/index?service=entitlement"
    },
    {
      "source": "/api/football",
      "destination": "/api/index?service=football"
    },
    {
      "source": "/api/football-alt",
      "destination": "/api/index?service=football-alt"
    },
    {
      "source": "/api/kids",
      "destination": "/api/index?service=kids"
    },
    {
      "source": "/api/live",
      "destination": "/api/index?service=live"
    },
    {
      "source": "/api/livecheck",
      "destination": "/api/index?service=livecheck"
    },
    {
      "source": "/api/share",
      "destination": "/api/index?service=share"
    },
    {
      "source": "/api/sportsrc",
      "destination": "/api/index?service=sportsrc"
    },
    {
      "source": "/api/stripe-verify",
      "destination": "/api/index?service=stripe-verify"
    },
    {
      "source": "/api/tmdb",
      "destination": "/api/index?service=tmdb"
    },
    {
      "source": "/api/welcome",
      "destination": "/api/index?service=welcome"
    },
    {
      "source": "/s/:id",
      "destination": "/api/index?service=share&id=:id"
    },
    {
      "source": "/s",
      "destination": "/api/index?service=share"
    }
  ],
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og-share.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/sportsrc",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/kids-catalogue.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/lib/football-state.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
